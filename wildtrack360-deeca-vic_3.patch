+  vicCauseCode  String? @map("vic_cause_code") // Two-digit cause of injury
+  vicFateCode   String? @map("vic_fate_code") // Two-digit fate/status (died/released/transferred)
+  vicFoundRef   String? @map("vic_found_ref") // GPS coords or Melways map reference for FOUND column
